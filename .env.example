# Copy to .env.local and adjust. All variables below are public (exposed to the browser).

# Display name of the application
NEXT_PUBLIC_APP_NAME=ShikkhaAI

# Public URL of this frontend (used for metadata / absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL of the backend REST API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# "true" = use local mock services, "false" = call NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCK_API=true
